{
  "rules": {
    "usernames": {
      ".read": "auth != null",
      "$name": {
        ".write": "auth != null && (!data.exists() || data.val() === auth.uid) && newData.val() === auth.uid",
        ".validate": "$name.matches(/^[a-z0-9_]{3,16}$/)"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth.uid === $uid"
      }
    },
    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth.uid === $uid"
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth.uid === $uid",
        "$fid": {
          ".write": "auth.uid === $uid || (auth.uid === $fid && (!newData.exists() || root.child('requests/' + auth.uid + '/' + $uid).exists()))"
        }
      }
    },
    "requests": {
      "$uid": {
        ".read": "auth.uid === $uid",
        "$from": {
          ".write": "auth.uid === $uid || (auth.uid === $from && !root.child('blocks/' + $uid + '/' + auth.uid).exists())"
        }
      }
    },
    "sent": {
      "$uid": {
        ".read": "auth.uid === $uid",
        "$to": {
          ".write": "auth.uid === $uid || auth.uid === $to"
        }
      }
    },
    "blocks": {
      "$uid": {
        ".read": "auth.uid === $uid",
        ".write": "auth.uid === $uid"
      }
    },
    "invites": {
      "$uid": {
        ".read": "auth.uid === $uid",
        "$room": {
          ".write": "auth.uid === $uid || root.child('friends/' + $uid + '/' + auth.uid).exists()"
        }
      }
    },
    "inbox": {
      "$uid": {
        ".read": "auth.uid === $uid",
        "$msg": {
          ".write": "auth.uid === $uid || (!data.exists() && newData.child('from').val() === auth.uid && root.child('friends/' + $uid + '/' + auth.uid).exists())"
        }
      }
    },
    "rooms": {
      "$room": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "stats": {
      ".read": true,
      "g": {
        "$game": {
          "$f": {
            ".write": true,
            ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1 && $game.matches(/^[a-z0-9-]{1,40}$/) && $f.matches(/^(v|m|o)$/)"
          }
        }
      },
      "d": {
        "$day": {
          "$game": {
            "$f": {
              ".write": true,
              ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1 && $day.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && $game.matches(/^[a-z0-9-]{1,40}$/) && $f.matches(/^(v|m|o)$/)"
            }
          }
        }
      },
      "h": {
        "$h": {
          ".write": true,
          ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1 && $h.matches(/^([0-9]|1[0-9]|2[0-3])$/)"
        }
      },
      "w": {
        "$w": {
          ".write": true,
          ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1 && $w.matches(/^[0-6]$/)"
        }
      },
      "dev": {
        "$d": {
          ".write": true,
          ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1 && $d.matches(/^(handy|computer)$/)"
        }
      }
    }
  }
}